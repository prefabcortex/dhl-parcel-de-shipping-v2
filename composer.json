{
    "name": "prefabcortex/dhl-parcel-de-shipping-v2",
    "description": "Unofficial PHP client for Parcel DE Shipping API (Post & Parcel Germany) \u2014 Note: This is the specification of the DPDHL Group Parcel DE Shipping API for Post & Parcel Germany",
    "type": "library",
    "keywords": [
        "openapi",
        "api-client",
        "rest",
        "sdk",
        "dhl",
        "parcel",
        "de",
        "shipping"
    ],
    "homepage": "https://github.com/prefabcortex/dhl-parcel-de-shipping-v2",
    "license": "0BSD",
    "authors": [
        {
            "name": "Dominic Bla\u00df"
        }
    ],
    "support": {
        "issues": "https://github.com/prefabcortex/dhl-parcel-de-shipping-v2/issues",
        "source": "https://github.com/prefabcortex/dhl-parcel-de-shipping-v2"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "nyholm/psr7": "^1.8.2",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.0 || ^2.0",
        "symfony/validator": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Prefabcortex\\DhlParcelDeShippingV2\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Prefabcortex\\DhlParcelDeShippingV2\\Examples\\": "examples/",
            "Prefabcortex\\DhlParcelDeShippingV2\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.0.2",
        "phpunit/phpunit": "^13.0",
        "psr/log": "^3.0",
        "roave/backward-compatibility-check": "^8.21",
        "symfony/http-client": "^7.4 || ^8.0"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs-check": "php-cs-fixer check",
        "cs-fix": "php-cs-fixer fix",
        "bc-check": "roave-backward-compatibility-check"
    }
}
